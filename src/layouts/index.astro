---
import "@/styles/global.css";

import { cn } from "tailwind-variants";

import { Font } from "astro:assets";
import { SEO } from "astro-seo";

import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

interface Props {
  title?: string;
  description?: string;
  "main:class"?: string;
}

const defaultDescription = "Venha participar do MediaWeek! Oficinas, Palestras, Vila dos Artistas e mais!";

const { title = "Info", description = defaultDescription, "main:class": mainClass = [] } = Astro.props;
const { SITE: site, BASE_URL: base } = import.meta.env;
const baseURL = new URL(base, site);
---

<html lang="pt-BR">
  <head>
    <base href={base} />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="icon" href="./favicon.ico" />
    <link rel="sitemap" href="./sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--astro-font-jaro" />
    <Font cssVariable="--astro-font-jura" />
    <SEO
      title={"MediaWeek | " + title}
      description={description}
      openGraph={{
        basic: {
          type: "website",
          title: "MediaWeek | " + title,
          image: "./ogimage.png",
          url: baseURL,
        },
        optional: {
          description,
          locale: "pt-BR",
        },
      }}
      twitter={{
        image: "./ogimage.png",
        card: "summary_large_image",
        description,
        imageAlt: "MediaWeek Logo",
        title: "MediaWeek | " + title,
        site: baseURL.toString(),
      }}
    />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-dvh h-min relative">
    <Navbar />
    <main class:list={cn("grow", mainClass)}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
