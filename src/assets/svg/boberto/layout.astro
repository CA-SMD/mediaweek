---
import { type Props } from "./index";

const { size, class: className, ...props } = Astro.props;
---

<svg
  width={size ? size : "128"}
  height={size ? size : "128"}
  viewBox="0 0 128 128"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["aspect-square w-auto", className]}
  {...props}
>
  <title>Mascote Media Week Boberto</title>
  <slot />
</svg>
