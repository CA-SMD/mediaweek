---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { href, ...props } = Astro.props;
const basedPathname = (href: string | URL) => {
  if (href instanceof URL) return new URL(href, Astro.url).pathname;
  if (href === "/") return new URL(".", Astro.url).pathname;
  if (href.charAt(0) === "/") href = href.replace("/", "");
  return new URL(href, Astro.url).pathname;
};
---

<a href={href && basedPathname(href)} {...props}>
  <slot />
</a>
