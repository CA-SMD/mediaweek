---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { BASE_URL: base } = import.meta.env;
const { href, ...props } = Astro.props;
const basedPathname = (href: string | URL) => base + href;
---

<a href={href && basedPathname(href)} {...props}>
  <slot />
</a>
