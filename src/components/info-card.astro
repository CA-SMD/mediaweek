---
import { AlarmClockIcon, MapPinIcon, CalendarDaysIcon, type AstroComponent } from "@lucide/astro";
import { cn } from "tailwind-variants";

type InfoIconVariant = "clock" | "pin" | "calendar";

interface Props {
  class?: string;
  icon: InfoIconVariant;
}

const icons: Record<InfoIconVariant, AstroComponent> = {
  clock: AlarmClockIcon,
  pin: MapPinIcon,
  calendar: CalendarDaysIcon,
};

const { icon, class: className } = Astro.props;
const Icon = icons[icon];
---

<div
  class:list={cn(
    "rounded-4xl bg-dark-950 size-28 md:size-40 text-bright-50 space-y-2 text-center p-5 font-passion-one text-xs md:text-xl",
    className,
  )}
>
  <Icon class="size-8 md:size-16 mx-auto" />
  <slot />
</div>
