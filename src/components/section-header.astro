---
import { tv, type VariantProps } from "tailwind-variants";

const styles = tv({
  base: "text-center py-4 px-24 breakout-popout text-bright-50 rounded-2xl underline uppercase font-jaro text-4xl",
  variants: {
    variant: {
      default: 'bg-dark-950',
      design: "bg-design-500",
      audiovisual: "bg-audiovisual-500",
      jogos: "bg-jogos-500",
      sistemas: "bg-sistemas-500",
    },
  },
  defaultVariants: {
    variant: 'default'
  }
});

interface Props extends VariantProps<typeof styles> {
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<h2 class:list={styles({ variant, className })}>
  <slot />
</h2>
