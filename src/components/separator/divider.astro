---
type VariantColors = "design" | "jogos" | "audiovisual" | "sistemas";

interface Props extends astroHTML.JSX.SVGAttributes {
  "side:right": VariantColors;
  "side:left": VariantColors;
  size?: number;
}

const colors: Record<VariantColors, string> = {
  design: "var(--color-design-500,#FFA2FF)",
  audiovisual: "var(--color-audiovisual-500,#00DD90)",
  jogos: "var(--color-jogos-500,#FF5343)",
  sistemas: "var(--color-sistemas-500,#01A0EA)",
};

const { "side:left": left, "side:right": right, size, class: className, ...props } = Astro.props;
---

<svg
  width={size ? size : "32"}
  height={size ? size : "32"}
  viewBox="0 0 1 1"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["aspect-square w-auto", className]}
  role="figure"
  aria-hidden="true"
  {...props}
>
  <path d="M1 0L0 1H1V0Z" fill={colors[right]}></path>
  <path d="M0 0V1L1 0H0Z" fill={colors[left]}></path>
</svg>
